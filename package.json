{
	"name": "n8n-nodes-openair",
	"version": "0.1.0",
	"description": "Custom n8n node for NetSuite SuiteProjects Pro application. This node's role is to streamline XML API usage by creating easy-to-use interface for creating and sending API requests",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Dominik Hażak",
		"email": "dominik@hazak.us"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/hasashin/n8n-openair-node.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OpenAirBasicApi.credentials.js",
			"dist/credentials/OpenAirOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/OpenAir/OpenAir.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
